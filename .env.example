# ========================================================
# OnboardIQ Configuration Environment Variables
# ========================================================

# Database (PostgreSQL recommended; SQLite fallback supported)
DATABASE_URL=postgresql://onboardiq:onboardiq_password@localhost:5432/onboardiq
# Fallback local SQLite:
# DATABASE_URL=sqlite:///./onboardiq.db

# Ollama / Local Open-Weights LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
USE_LOCAL_LLM=false
DEMO_MODE=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
